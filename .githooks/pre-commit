#!/usr/bin/env bash
# Pre-commit checks.
#
# Codifies the verification pass used throughout the vulkan_earth C++
# modernization/naming migration (see the git log around "vulkan_earth
# Phase B/C" and "resolve every constructor/setter param-vs-member
# shadow") and confirmed clean-by-default in lib/ and bin/ (the
# tutorials) against the same checks:
#   1. build            - staged .cpp/.h files must still compile
#   2. -Wshadow         - no local/parameter may shadow a member (this is
#                          what makes vulkan_earth's `this->` removal and
#                          bare `member = param;` assignments safe)
#   3. self-assignment  - `x = x;` / `a.b = a.b;` (the exact shape of the
#                          Tank::setHP and SubMenu*::setPercentBorder bugs
#                          found during that migration)
#   4. naming/length    - the project's .clang-tidy readability-identifier-
#                          naming / readability-identifier-length rules
#
# Runs against three areas independently - vulkan_earth/src, lib/, and
# bin/ (the tutorials) - each with that area's own real compiler flags,
# and only against files actually staged there. Checks run against the
# exact content that will be committed (unstaged changes are stashed out
# of the way for the duration). Missing tooling (bear, clang-tidy, g++)
# degrades a check to a skipped warning rather than a blocked commit,
# since this hook isn't installed by default (see .githooks/README.md)
# and shouldn't brick a commit on a machine without the full toolchain.
#
# Bypass for a single commit: git commit --no-verify

set -u

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

AREAS_WITH_CHANGES=()
ANY_STAGED_ALL=0
FAIL=0

# --- per-area check: self-assignment, -Wshadow, naming/length ----------
# $1 = area label (for messages)  $2 = dir relative to REPO_ROOT
# $3.. = extra -I/-D flags for that area's real compile command
check_area() {
    local label="$1" dir="$2"
    shift 2
    local extra_flags=("$@")

    local staged_cpp staged_all
    mapfile -t staged_cpp < <(git diff --cached --name-only --diff-filter=ACM -- "$dir/*.cpp")
    mapfile -t staged_all < <(git diff --cached --name-only --diff-filter=ACM -- "$dir/*.cpp" "$dir/*.h")

    if [ "${#staged_all[@]}" -eq 0 ]; then
        return 0
    fi
    AREAS_WITH_CHANGES+=("$dir")
    ANY_STAGED_ALL=1

    local basenames=() basenames_all=() f
    for f in "${staged_cpp[@]}"; do basenames+=("$(basename "$f")"); done
    for f in "${staged_all[@]}"; do basenames_all+=("$(basename "$f")"); done

    ( cd "$dir"

      echo "pre-commit [$label]: scanning for self-assignment (x = x;)..." >&2
      SELFASSIGN=$(python3 - "${basenames_all[@]}" <<'PYEOF'
import re, sys
pat_bare = re.compile(r'(?<![>.\w])([a-zA-Z_][a-zA-Z_0-9]*)\s*=\s*\1\s*;')
pat_member = re.compile(r'\b([a-zA-Z_][a-zA-Z_0-9]*\.[a-zA-Z_][a-zA-Z_0-9]*)\s*=\s*\1\s*;')
found = 0
for fname in sys.argv[1:]:
    try:
        with open(fname) as f:
            lines = f.readlines()
    except (IsADirectoryError, FileNotFoundError):
        continue
    for i, line in enumerate(lines, 1):
        for pat in (pat_bare, pat_member):
            for m in pat.finditer(line):
                print(f'{fname}:{i}: {line.strip()}')
                found += 1
sys.exit(1 if found else 0)
PYEOF
)
      if [ -n "$SELFASSIGN" ]; then
          echo "pre-commit [$label]: SELF-ASSIGNMENT FOUND (writes a value to itself instead of a member):" >&2
          echo "$SELFASSIGN" >&2
          echo 1 > /tmp/precommit_fail_marker
      fi

      if command -v g++ >/dev/null 2>&1; then
          echo "pre-commit [$label]: checking for variable/parameter shadowing (-Wshadow)..." >&2
          for fname in "${basenames[@]}"; do
              [ -f "$fname" ] || continue
              OUT=$(g++ -std=gnu++20 -Wshadow -fsyntax-only "${extra_flags[@]}" "$fname" 2>&1 | grep 'shadows' || true)
              if [ -n "$OUT" ]; then
                  echo "pre-commit [$label]: SHADOW WARNING in $fname:" >&2
                  echo "$OUT" >&2
                  echo 1 > /tmp/precommit_fail_marker
              fi
          done
      else
          echo "pre-commit [$label]: g++ not found, skipping -Wshadow check" >&2
      fi

      if ! command -v run-clang-tidy >/dev/null 2>&1; then
          echo "pre-commit [$label]: run-clang-tidy not found, skipping naming/length check" >&2
      elif [ "${#basenames[@]}" -eq 0 ]; then
          echo "pre-commit [$label]: no staged .cpp file to anchor a naming/length check (header-only change; covered by the build check instead)" >&2
      elif [ ! -f compile_commands.json ]; then
          echo "pre-commit [$label]: no compile_commands.json in $dir, skipping naming/length check (see .githooks/README.md to generate one)" >&2
      else
          echo "pre-commit [$label]: checking naming/length conventions (clang-tidy)..." >&2
          # -header-filter='.*' is deliberately broad (a narrower regex here
          # silently matches nothing at all - see the "fix header-filter bug"
          # commit in the vulkan_earth history for what that cost), which
          # means it also reports pre-existing violations in ANY transitively-
          # included project header, not just the ones staged in this commit
          # (e.g. include/vulkan_graphix/Tools.h's still-PascalCase AutoDeleter
          # template, pulled in by nearly every lib/ .cpp). A commit that
          # doesn't touch that header shouldn't be blocked by it. So: keep
          # -header-filter broad for correctness, then narrow the reported
          # warnings down to only the files actually staged in this commit
          # (plus drop vendored/third-party headers entirely - Khronos'
          # vk_platform.h, public-domain stb_image.h, and the Vulkan-spec-
          # named macros in ListOfFunctions.inl were never meant to follow
          # this project's naming convention).
          NAMING_OUT=$(run-clang-tidy -checks='-*,readability-identifier-naming,readability-identifier-length' \
                  -header-filter='.*' "${basenames[@]}" 2>&1 | grep 'warning:' \
                  | grep -v -E 'STBImage\.h|VulkanPlatform\.h|ListOfFunctions\.inl' \
                  | python3 -c "
import sys, os
staged = set(sys.argv[1:])
for line in sys.stdin:
    path = line.split(':', 1)[0]
    if os.path.basename(path) in staged:
        sys.stdout.write(line)
" "${basenames_all[@]}" || true)
          if [ -n "$NAMING_OUT" ]; then
              echo "pre-commit [$label]: NAMING/LENGTH VIOLATIONS (see CLAUDE.md's Clang-Tidy section for the project's exemption list):" >&2
              echo "$NAMING_OUT" >&2
              echo 1 > /tmp/precommit_fail_marker
          fi
      fi
    )
}

rm -f /tmp/precommit_fail_marker

check_area vulkan_earth vulkan_earth/src \
        -DHAVE_CONFIG_H -I. -I../.. -DFREEGLUT_STATIC -I/usr/include/SDL \
        -D_GNU_SOURCE=1 -D_REENTRANT -I/opt/boost/include

check_area lib lib \
        -DHAVE_CONFIG_H -I. -I.. -I"$REPO_ROOT/include" -I/opt/boost/include

check_area bin bin \
        -DHAVE_CONFIG_H -I. -I.. -I"$REPO_ROOT/include" -I/opt/boost/include

if [ "$ANY_STAGED_ALL" -eq 0 ]; then
    exit 0
fi

if [ -f /tmp/precommit_fail_marker ]; then
    FAIL=1
    rm -f /tmp/precommit_fail_marker
fi

# --- build (last: slowest check; one root build covers cross-dir deps,
#     e.g. a lib/ change that breaks something bin/ links against) ------
STASHED=0
if ! git diff --quiet -- "${AREAS_WITH_CHANGES[@]}"; then
    git stash push --keep-index --quiet --include-untracked \
            --message "pre-commit-autostash" -- "${AREAS_WITH_CHANGES[@]}"
    STASHED=1
fi
cleanup() {
    if [ "$STASHED" -eq 1 ]; then
        git stash pop --quiet
    fi
}
trap cleanup EXIT

echo "pre-commit: building (incremental, from repo root)..." >&2
if ! make -j4 >/tmp/precommit_build.log 2>&1; then
    echo "pre-commit: BUILD FAILED:" >&2
    tail -60 /tmp/precommit_build.log >&2
    FAIL=1
fi

if [ "$FAIL" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: one or more checks failed (see above). Fix, or bypass with 'git commit --no-verify'." >&2
    exit 1
fi

echo "pre-commit: all checks passed." >&2
exit 0
