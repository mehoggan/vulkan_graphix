#!/usr/bin/env bash
# Pre-commit checks.
#
# Codifies the verification pass used throughout the vulkan_earth C++
# modernization/naming migration (see the git log around "vulkan_earth
# Phase B/C" and "resolve every constructor/setter param-vs-member
# shadow") and confirmed clean-by-default in lib/ and bin/ (the
# tutorials) against the same checks:
#   1. build            - staged .cpp/.h files must still compile
#   2. -Wshadow         - no local/parameter may shadow a member (this is
#                          what makes vulkan_earth's `this->` removal and
#                          bare `member = param;` assignments safe)
#   3. self-assignment  - `x = x;` / `a.b = a.b;` (the exact shape of the
#                          Tank::setHP and SubMenu*::setPercentBorder bugs
#                          found during that migration)
#   4. naming/length    - the project's .clang-tidy readability-identifier-
#                          naming / readability-identifier-length rules
#   5. clang-format     - staged C++ in bin/, include/, lib/, tests/, and
#                          vulkan_earth/ must match .clang-format exactly
#                          (checked against the staged blob itself)
#
# Runs against four areas independently - vulkan_earth (src/ plus its
# headers in include/vulkan_earth/), lib/, bin/
# (the tutorials, each NN_*/ folder holding its own TutorialNN.{h,cpp}),
# and include/vulkan_graphix (lib/'s public headers) -
# each with that area's own real compiler flags, and only against files
# actually staged there. Checks run against the exact content that will
# be committed (unstaged changes are stashed out of the way for the
# duration). Missing tooling (bear, clang-tidy, g++, clang-format) degrades a check to
# a skipped warning rather than a blocked commit, since this hook isn't
# installed by default (see .githooks/README.md) and shouldn't brick a
# commit on a machine without the full toolchain.
#
# include/vulkan_graphix has no .cpp of its own to compile as a check
# anchor (unlike the other three areas), so its shadow/naming checks
# compile against every lib/*.cpp instead - lib/ is the primary
# consumer of these public headers, and it's how the Tools.h AutoDeleter
# PascalCase-member finding (the reason this area exists at all) was
# actually caught, since nothing in lib/ was staged that day.
#
# Bypass for a single commit: git commit --no-verify

set -u

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

AREAS_WITH_CHANGES=()
ANY_STAGED_ALL=0
FAIL=0

# Directory holding the compile_commands.json run-clang-tidy should use
# for area $1: the area's own (.githooks/README.md's per-area recipe) if
# present, otherwise the out-of-tree build/ one (CLAUDE.md's
# `bear -- make` from build/). Prints nothing if neither exists.
compile_db_dir() {
    if [ -f "$REPO_ROOT/$1/compile_commands.json" ]; then
        echo "$REPO_ROOT/$1"
    elif [ -f "$REPO_ROOT/build/compile_commands.json" ]; then
        echo "$REPO_ROOT/build"
    fi
}

# run-clang-tidy treats each file argument as a regex searched against
# the database's absolute paths, so anchor on the full path of repo-
# relative file $1 - otherwise bin/'s 22 main.cpp files, or same-named
# files in different areas of the shared build/ database, cross-match.
path_regex() {
    printf '^%s$' "$(printf '%s' "$REPO_ROOT/$1" | sed 's/[][\.*^$+?(){}|]/\\&/g')"
}

# --- per-area check: self-assignment, -Wshadow, naming/length ----------
# $1 = area label (for messages)  $2 = dir relative to REPO_ROOT
# $3 = the area's separate header dir relative to REPO_ROOT, or "" if its
#      headers live in $2 itself (vulkan_earth keeps its .cpp files in
#      src/ but its headers in include/vulkan_earth/)
# $4.. = extra -I/-D flags for that area's real compile command
check_area() {
    local label="$1" dir="$2" header_dir="$3"
    shift 3
    local extra_flags=("$@")

    local header_globs=()
    if [ -n "$header_dir" ]; then
        header_globs=("$header_dir/*.h")
    fi

    local staged_cpp staged_all
    mapfile -t staged_cpp < <(git diff --cached --name-only --diff-filter=ACMR -- "$dir/*.cpp")
    mapfile -t staged_all < <(git diff --cached --name-only --diff-filter=ACMR -- "$dir/*.cpp" "$dir/*.h" "${header_globs[@]}")

    if [ "${#staged_all[@]}" -eq 0 ]; then
        return 0
    fi
    AREAS_WITH_CHANGES+=("$dir")
    if [ -n "$header_dir" ]; then
        AREAS_WITH_CHANGES+=("$header_dir")
    fi
    ANY_STAGED_ALL=1

    # File operations below run from inside $dir, so use paths relative to
    # it (bin/'s entry points live in subdirectories, e.g.
    # bin/03_first_triangle/main.cpp); basenames are only used to match
    # clang-tidy's reported warning paths back to the staged files.
    local relpaths=() relpaths_all=() basenames_all=() tidy_files=() f
    for f in "${staged_cpp[@]}"; do
        relpaths+=("${f#"$dir"/}")
        tidy_files+=("$(path_regex "$f")")
    done
    for f in "${staged_all[@]}"; do
        relpaths_all+=("$(realpath -m --relative-to="$dir" "$f")")
        basenames_all+=("$(basename "$f")")
    done
    local db_dir
    db_dir=$(compile_db_dir "$dir")

    ( cd "$dir"

      echo "pre-commit [$label]: scanning for self-assignment (x = x;)..." >&2
      SELFASSIGN=$(python3 - "${relpaths_all[@]}" <<'PYEOF'
import re, sys
pat_bare = re.compile(r'(?<![>.\w])([a-zA-Z_][a-zA-Z_0-9]*)\s*=\s*\1\s*;')
pat_member = re.compile(r'\b([a-zA-Z_][a-zA-Z_0-9]*\.[a-zA-Z_][a-zA-Z_0-9]*)\s*=\s*\1\s*;')
found = 0
for fname in sys.argv[1:]:
    try:
        with open(fname) as f:
            lines = f.readlines()
    except (IsADirectoryError, FileNotFoundError):
        continue
    for i, line in enumerate(lines, 1):
        for pat in (pat_bare, pat_member):
            for m in pat.finditer(line):
                print(f'{fname}:{i}: {line.strip()}')
                found += 1
sys.exit(1 if found else 0)
PYEOF
)
      if [ -n "$SELFASSIGN" ]; then
          echo "pre-commit [$label]: SELF-ASSIGNMENT FOUND (writes a value to itself instead of a member):" >&2
          echo "$SELFASSIGN" >&2
          echo 1 > /tmp/precommit_fail_marker
      fi

      if command -v g++ >/dev/null 2>&1; then
          echo "pre-commit [$label]: checking for variable/parameter shadowing (-Wshadow)..." >&2
          for fname in "${relpaths[@]}"; do
              [ -f "$fname" ] || continue
              OUT=$(g++ -std=gnu++20 -Wshadow -fsyntax-only "${extra_flags[@]}" "$fname" 2>&1 | grep 'shadows' || true)
              if [ -n "$OUT" ]; then
                  echo "pre-commit [$label]: SHADOW WARNING in $fname:" >&2
                  echo "$OUT" >&2
                  echo 1 > /tmp/precommit_fail_marker
              fi
          done
      else
          echo "pre-commit [$label]: g++ not found, skipping -Wshadow check" >&2
      fi

      if ! command -v run-clang-tidy >/dev/null 2>&1; then
          echo "pre-commit [$label]: run-clang-tidy not found, skipping naming/length check" >&2
      elif [ "${#relpaths[@]}" -eq 0 ]; then
          echo "pre-commit [$label]: no staged .cpp file to anchor a naming/length check (header-only change; covered by the build check instead)" >&2
      elif [ -z "$db_dir" ]; then
          echo "pre-commit [$label]: no compile_commands.json in $dir or build/, skipping naming/length check (see .githooks/README.md to generate one)" >&2
      else
          echo "pre-commit [$label]: checking naming/length conventions (clang-tidy)..." >&2
          # -header-filter='.*' is deliberately broad (a narrower regex here
          # silently matches nothing at all - see the "fix header-filter bug"
          # commit in the vulkan_earth history for what that cost), which
          # means it also reports pre-existing violations in ANY transitively-
          # included project header, not just the ones staged in this commit
          # (e.g. include/vulkan_graphix/Tools.h's still-PascalCase AutoDeleter
          # template, pulled in by nearly every lib/ .cpp). A commit that
          # doesn't touch that header shouldn't be blocked by it. So: keep
          # -header-filter broad for correctness, then narrow the reported
          # warnings down to only the files actually staged in this commit
          # (plus drop vendored/third-party headers entirely - Khronos'
          # vk_platform.h, public-domain stb_image.h, and the Vulkan-spec-
          # named macros in ListOfFunctions.inl were never meant to follow
          # this project's naming convention).
          NAMING_OUT=$(run-clang-tidy -p "$db_dir" \
                  -checks='-*,readability-identifier-naming,readability-identifier-length' \
                  -header-filter='.*' "${tidy_files[@]}" 2>&1 | grep 'warning:' \
                  | grep -v -E 'STBImage\.h|VulkanPlatform\.h|ListOfFunctions\.inl' \
                  | python3 -c "
import sys, os
staged = set(sys.argv[1:])
for line in sys.stdin:
    path = line.split(':', 1)[0]
    if os.path.basename(path) in staged:
        sys.stdout.write(line)
" "${basenames_all[@]}" | sort -u || true)
          if [ -n "$NAMING_OUT" ]; then
              echo "pre-commit [$label]: NAMING/LENGTH VIOLATIONS (see CLAUDE.md's Clang-Tidy section for the project's exemption list):" >&2
              echo "$NAMING_OUT" >&2
              echo 1 > /tmp/precommit_fail_marker
          fi
      fi
    )
}

# --- include/vulkan_graphix: same idea, but there's no .cpp in this
# area to compile directly, so shadow/naming checks use every lib/*.cpp
# as the anchor TU set instead (lib/ is the primary consumer of these
# public headers) and then narrow the reported warnings down to just
# the staged header files, same as check_area does for its own area.
check_include_area() {
    local dir="include/vulkan_graphix"
    local staged_all
    mapfile -t staged_all < <(git diff --cached --name-only --diff-filter=ACM -- \
            "$dir/*.h" "$dir/*.hpp" "$dir/*.inl" \
            "$dir/Math/*.hpp" "$dir/VertexTypes/*.hpp")

    if [ "${#staged_all[@]}" -eq 0 ]; then
        return 0
    fi
    AREAS_WITH_CHANGES+=("$dir")
    ANY_STAGED_ALL=1

    # Relative paths for reading files from inside $dir (headers live in
    # Tutorial/, Math/, VertexTypes/ subdirectories too); basenames only
    # for matching clang-tidy's warning paths back to the staged files.
    local relpaths_all=() basenames_all=() f
    for f in "${staged_all[@]}"; do
        relpaths_all+=("${f#"$dir"/}")
        basenames_all+=("$(basename "$f")")
    done

    ( cd "$dir"

      echo "pre-commit [include]: scanning for self-assignment (x = x;)..." >&2
      SELFASSIGN=$(python3 - "${relpaths_all[@]}" <<'PYEOF'
import re, sys
pat_bare = re.compile(r'(?<![>.\w])([a-zA-Z_][a-zA-Z_0-9]*)\s*=\s*\1\s*;')
pat_member = re.compile(r'\b([a-zA-Z_][a-zA-Z_0-9]*\.[a-zA-Z_][a-zA-Z_0-9]*)\s*=\s*\1\s*;')
found = 0
for fname in sys.argv[1:]:
    try:
        with open(fname) as f:
            lines = f.readlines()
    except (IsADirectoryError, FileNotFoundError):
        continue
    for i, line in enumerate(lines, 1):
        for pat in (pat_bare, pat_member):
            for m in pat.finditer(line):
                print(f'{fname}:{i}: {line.strip()}')
                found += 1
sys.exit(1 if found else 0)
PYEOF
)
      if [ -n "$SELFASSIGN" ]; then
          echo "pre-commit [include]: SELF-ASSIGNMENT FOUND (writes a value to itself instead of a member):" >&2
          echo "$SELFASSIGN" >&2
          echo 1 > /tmp/precommit_fail_marker
      fi
    )

    ( cd lib
      local lib_flags=(-DHAVE_CONFIG_H -I. -I.. -I"$REPO_ROOT/include" -I/opt/boost/include)
      local lib_basenames=() lib_tidy_files=() db_dir
      f=""
      for f in *.cpp; do
          lib_basenames+=("$f")
          lib_tidy_files+=("$(path_regex "lib/$f")")
      done
      db_dir=$(compile_db_dir lib)

      if command -v g++ >/dev/null 2>&1; then
          echo "pre-commit [include]: checking for variable/parameter shadowing (-Wshadow), compiling all of lib/ against the staged headers..." >&2
          for fname in "${lib_basenames[@]}"; do
              OUT=$(g++ -std=gnu++20 -Wshadow -fsyntax-only "${lib_flags[@]}" "$fname" 2>&1 | grep 'shadows' || true)
              if [ -n "$OUT" ]; then
                  echo "pre-commit [include]: SHADOW WARNING (via lib/$fname):" >&2
                  echo "$OUT" >&2
                  echo 1 > /tmp/precommit_fail_marker
              fi
          done
      else
          echo "pre-commit [include]: g++ not found, skipping -Wshadow check" >&2
      fi

      if ! command -v run-clang-tidy >/dev/null 2>&1; then
          echo "pre-commit [include]: run-clang-tidy not found, skipping naming/length check" >&2
      elif [ -z "$db_dir" ]; then
          echo "pre-commit [include]: no compile_commands.json in lib/ or build/, skipping naming/length check (see .githooks/README.md to generate one)" >&2
      else
          echo "pre-commit [include]: checking naming/length conventions (clang-tidy), via lib/*.cpp..." >&2
          NAMING_OUT=$(run-clang-tidy -p "$db_dir" \
                  -checks='-*,readability-identifier-naming,readability-identifier-length' \
                  -header-filter='.*' "${lib_tidy_files[@]}" 2>&1 | grep 'warning:' \
                  | grep -v -E 'STBImage\.h|VulkanPlatform\.h|ListOfFunctions\.inl' \
                  | python3 -c "
import sys, os
staged = set(sys.argv[1:])
for line in sys.stdin:
    path = line.split(':', 1)[0]
    if os.path.basename(path) in staged:
        sys.stdout.write(line)
" "${basenames_all[@]}" | sort -u || true)
          if [ -n "$NAMING_OUT" ]; then
              echo "pre-commit [include]: NAMING/LENGTH VIOLATIONS (see CLAUDE.md's Clang-Tidy section for the project's exemption list):" >&2
              echo "$NAMING_OUT" >&2
              echo 1 > /tmp/precommit_fail_marker
          fi
      fi
    )
}

rm -f /tmp/precommit_fail_marker

check_area vulkan_earth vulkan_earth/src vulkan_earth/include \
        -DHAVE_CONFIG_H -I. -I../.. -I"$REPO_ROOT/vulkan_earth/include" \
        -DFREEGLUT_STATIC -I/usr/include/SDL \
        -D_GNU_SOURCE=1 -D_REENTRANT -I/opt/boost/include

check_area lib lib "" \
        -DHAVE_CONFIG_H -I. -I.. -I"$REPO_ROOT/include" -I/opt/boost/include

check_area bin bin "" \
        -DHAVE_CONFIG_H -I. -I.. -I"$REPO_ROOT/include" -I/opt/boost/include

check_include_area

# --- clang-format: staged C++ must already match .clang-format ---------
# Covers every C++ area, tests/ included (unlike the per-area checks
# above). Formats the staged (index) blob via `git show :path`, not the
# working-tree file, so a file that's formatted on disk but staged
# unformatted still fails. The vendored STB headers aren't ours to
# format.
check_format() {
    local staged=() unformatted=() f
    mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR \
            -- '*.cpp' '*.h' '*.hpp' \
            | grep -E '^(bin|include|lib|tests|vulkan_earth)/' \
            | grep -v -E '(^|/)STB(Image|TrueType)\.h$')
    if [ "${#staged[@]}" -eq 0 ]; then
        return 0
    fi
    if ! command -v clang-format >/dev/null 2>&1; then
        echo "pre-commit [format]: clang-format not found, skipping formatting check" >&2
        return 0
    fi

    echo "pre-commit [format]: checking formatting (clang-format)..." >&2
    for f in "${staged[@]}"; do
        if ! git show ":$f" | clang-format --style=file \
                --assume-filename="$REPO_ROOT/$f" --dry-run --Werror \
                >/dev/null 2>&1; then
            unformatted+=("$f")
        fi
    done
    if [ "${#unformatted[@]}" -gt 0 ]; then
        echo "pre-commit [format]: NOT CLANG-FORMATTED (fix with the command below, then re-stage):" >&2
        printf '  %s\n' "${unformatted[@]}" >&2
        echo "  clang-format -i ${unformatted[*]} && git add ${unformatted[*]}" >&2
        echo 1 > /tmp/precommit_fail_marker
    fi
}

check_format

if [ "$ANY_STAGED_ALL" -eq 0 ]; then
    # Nothing staged in the four compiled areas (e.g. a tests/-only
    # commit), so skip the build - but still honor a formatting failure.
    if [ -f /tmp/precommit_fail_marker ]; then
        rm -f /tmp/precommit_fail_marker
        echo "" >&2
        echo "pre-commit: one or more checks failed (see above). Fix, or bypass with 'git commit --no-verify'." >&2
        exit 1
    fi
    exit 0
fi

if [ -f /tmp/precommit_fail_marker ]; then
    FAIL=1
    rm -f /tmp/precommit_fail_marker
fi

# --- build (last: slowest check; one root build covers cross-dir deps,
#     e.g. a lib/ change that breaks something bin/ links against) ------
STASHED=0
if ! git diff --quiet -- "${AREAS_WITH_CHANGES[@]}"; then
    git stash push --keep-index --quiet --include-untracked \
            --message "pre-commit-autostash" -- "${AREAS_WITH_CHANGES[@]}"
    STASHED=1
fi
cleanup() {
    if [ "$STASHED" -eq 1 ]; then
        git stash pop --quiet
    fi
}
trap cleanup EXIT

# Build wherever the tree is actually configured: an in-tree build has a
# Makefile at the repo root, an out-of-tree one (CLAUDE.md's
# `mkdir build && cd build && ../configure`) has it under build/ instead.
if [ -f "$REPO_ROOT/Makefile" ]; then
    BUILD_DIR="$REPO_ROOT"
    BUILD_LABEL="repo root"
elif [ -f "$REPO_ROOT/build/Makefile" ]; then
    BUILD_DIR="$REPO_ROOT/build"
    BUILD_LABEL="build/"
else
    BUILD_DIR=""
fi

if [ -z "$BUILD_DIR" ]; then
    echo "pre-commit: BUILD FAILED: no Makefile at the repo root or in build/ - run ./configure (in-tree) or ../configure from build/ first" >&2
    FAIL=1
else
    echo "pre-commit: building (incremental, from $BUILD_LABEL)..." >&2
    if ! make -C "$BUILD_DIR" -j4 >/tmp/precommit_build.log 2>&1; then
        echo "pre-commit: BUILD FAILED:" >&2
        tail -60 /tmp/precommit_build.log >&2
        FAIL=1
    fi
fi

if [ "$FAIL" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: one or more checks failed (see above). Fix, or bypass with 'git commit --no-verify'." >&2
    exit 1
fi

echo "pre-commit: all checks passed." >&2
exit 0
